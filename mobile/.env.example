# Backend API base URL used by the mobile app.
#
# Leave this unset during local development: the app will use the same host
# Metro/Expo is served from (port 8000). That works for Expo Go on a physical
# phone as long as the phone and computer are on the same network.
#
# Set it explicitly when the backend is deployed or lives on another host:
# EXPO_PUBLIC_API_BASE_URL=https://your-backend.onrender.com/api/v1
#
# For a local physical device you can also hard-code your computer's LAN IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1
#
# If you start Expo with `--tunnel`, set this to a publicly reachable backend
# URL (the tunnel only exposes Metro, not your local API).
#
# After changing this file, restart Metro (`npx expo start -c`).
